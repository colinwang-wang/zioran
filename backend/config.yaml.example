server:
  port: 8080
database:
  host: 127.0.0.1
  port: 3306
  user: root
  password: root123456
  dbname: zioran
redis:
  host: 127.0.0.1
  port: 6379
jwt:
  secret: zioran-jwt-secret-change-me
  expire: 72h

sms:
  provider: mock  # mock | aliyun | tencent
  aliyun:
    access_key_id: ""
    access_key_secret: ""
    sign_name: "知猿"
    template_code: "SMS_123456"
  tencent:
    secret_id: ""
    secret_key: ""
    app_id: ""
    sign_name: "知猿"
    template_id: ""

payment:
  wechat:
    enabled: false
    mock_auto_complete: false
    app_id: ""
    mch_id: ""
    api_key: ""
    notify_url: "https://api.zioran.com/api/v1/pay/notify/wechat"
    serial_no: ""
    private_key_path: ""
    # 微信支付平台证书路径，用于验证回调 Wechatpay-Signature。
    cert_path: ""
    # 如使用微信支付公钥验签，配置 public_key_path；拿到 PUB_KEY_ID_... 后填 public_key_id。
    public_key_path: ""
    public_key_id: ""
  alipay:
    enabled: false
    mock_auto_complete: false
    app_id: ""
    private_key: ""
    alipay_public_key: ""
    notify_url: "https://api.zioran.com/api/v1/pay/notify/alipay"
    return_url: "https://www.zioran.com/user/transactions"

oauth:
  wechat:
    enabled: false
    app_id: ""
    app_secret: ""
    # 微信开放平台网站应用扫码登录。redirect_uri 可配置为前端回调页，
    # 也可配置为后端 /api/v1/auth/oauth/wechat/callback，再由 frontend_redirect_uri 中转到前端。
    redirect_uri: "https://api.zioran.com/api/v1/auth/oauth/wechat/callback"
    frontend_redirect_uri: "https://www.zioran.com/auth/wechat/callback"
